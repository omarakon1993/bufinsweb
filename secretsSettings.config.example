<?xml version="1.0" encoding="utf-8"?>
<!-- Copia este archivo como secretsSettings.config y llena los valores reales. -->
<!-- secretsSettings.config está en .gitignore y NUNCA debe subirse a git. -->
<appSettings>
  <add key="SMTP_HOST" value="tu-servidor-smtp.com" />
  <add key="SMTP_PORT" value="465" />
  <add key="SMTP_USER" value="correo@tudominio.com" />
  <add key="SMTP_PASSWORD" value="tu-contraseña-smtp" />
  <add key="SMTP_FROM_EMAIL" value="correo@tudominio.com" />
  <add key="ADMIN_EMAIL" value="admin@tudominio.com" />
  <add key="SMTP_ENABLE_SSL" value="true" />
</appSettings>
