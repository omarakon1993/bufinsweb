<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>bufinsweb</RootNamespace>
    <AssemblyName>bufinsweb</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>bufinsweb-7c1f0a52</UserSecretsId>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <NoWarn>$(NoWarn);CA1416;ASP0019</NoWarn>
  </PropertyGroup>

  <!-- Tools\PulsoEtl es otro programa (.NET Framework, el ETL): no forma parte del sitio -->
  <ItemGroup>
    <Compile Remove="Tools\**;packages\**" />
    <Content Remove="Tools\**;packages\**" />
    <EmbeddedResource Remove="Tools\**;packages\**" />
    <None Remove="Tools\**;packages\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUglify" Version="1.21.15" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- Textos del sitio: App_GlobalResources\Strings(.en-US).resx -> clase Resources.Strings (la usan las vistas) -->
  <ItemGroup>
    <EmbeddedResource Update="App_GlobalResources\Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>bufinsweb.App_GlobalResources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Contenido que viaja con la publicación (los estáticos viven en /Assets, no en wwwroot) -->
  <ItemGroup>
    <Content Include="Assets\**\*" Exclude="Assets\**\*.json;Assets\**\*.config" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="favicon.ico;Bufins_Favicon_Ink.ico" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="App_Data\pulso\**\*" Exclude="App_Data\pulso\**\*.json;App_Data\pulso\uso\**;App_Data\pulso\etl.lock" CopyToPublishDirectory="PreserveNewest" />
    <!-- lo que genera el sitio o el ETL en ejecución no viaja con la publicación -->
    <Content Remove="App_Data\pulso\uso\**;App_Data\pulso\etl_status.json" />
    <!-- NUNCA publicar credenciales: el SDK Web incluye por defecto todos los .json/.config -->
    <Content Remove="secretsSettings.json;secretsSettings.config;secretsSettings.*.json;*.example" />
    <None Remove="secretsSettings.json;secretsSettings.config" />
  </ItemGroup>

</Project>
