<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para IIS (hosting compartido, ASP.NET Core Module). `dotnet publish` completa los atributos de <aspNetCore>
  según el tipo de publicación (dependiente del framework o self-contained). Lo demás (cabeceras de seguridad,
  compresión, caché de estáticos, idioma) lo hace la propia aplicación, ver Program.cs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\bufinsweb.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
      </security>
    </system.webServer>
  </location>
</configuration>
