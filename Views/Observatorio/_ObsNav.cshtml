@using bufinsweb.Helpers
@{
    var T = new Func<string, string, string>(ObservatorioFormat.T);
    var activo = (string)ViewBag.ObsActive ?? "";
    Func<string, string> cls = k => k == activo ? "active" : "";
}
<span id="obsMeta" data-v="@ViewBag.ObsVer" hidden></span>
<div class="obs-subnav">
    <div class="container-xl obs-subnav-in">
        <nav class="obs-subnav-links" aria-label="Observatorio">
            <a href="/observatorio" class="@cls("home")"><i class="fas fa-home"></i><span>@T("Inicio", "Home")</span></a>
            <a href="/observatorio/sectores" class="@cls("sectores")"><i class="fas fa-industry"></i><span>@T("Análisis por sector", "Sector analysis")</span></a>
            <a href="/observatorio/ranking" class="@cls("ranking")"><i class="fas fa-trophy"></i><span>@T("Rankings", "Rankings")</span></a>
            <a href="/observatorio/comparar" class="@cls("comparar")"><i class="fas fa-balance-scale"></i><span>@T("Comparar empresas", "Compare companies")</span></a>
            <span class="obs-subnav-tag @cls("empresa")"><i class="fas fa-building"></i><span>@T("Análisis individual", "Company profile")</span></span>
        </nav>
        <label class="obs-unit" title="@T("Unidad en la que se muestran las cifras en pesos", "Unit used for peso figures")">
            <span>@T("Unidad", "Unit")</span>
            <select id="obsUnit" class="form-select form-select-sm" aria-label="@T("Unidad de las cifras", "Figures unit")">
                <option value="auto">@T("Automática", "Automatic")</option>
                <option value="pesos">@T("Pesos", "Pesos")</option>
                <option value="miles">@T("Miles", "Thousands")</option>
                <option value="millones">@T("Millones", "Millions")</option>
                <option value="milmillones">@T("Miles de millones", "Billions")</option>
                <option value="billones">@T("Billones", "Trillions")</option>
            </select>
        </label>
        <div class="obs-subnav-search">
            <div class="obs-input-icon">
                <i class="fas fa-search"></i>
                <input id="obsGlobalSearch" type="search" class="form-control" placeholder="@T("Buscar empresa por nombre o NIT…", "Search company by name or tax ID…")" aria-label="@T("Buscar empresa", "Search company")" />
            </div>
        </div>
    </div>
</div>
