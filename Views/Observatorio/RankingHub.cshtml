@using bufinsweb.Helpers
@using bufinsweb.Models.Observatorio
@using bufinsweb.Services
@{
    var datos = (ObservatorioDatos)ViewBag.Datos;
    var hub = (ObservatorioService.HubRanking)ViewBag.Hub;
    var cat = CiiuCatalogo.Actual;
    var T = new Func<string, string, string>(ObservatorioFormat.T);
    ViewBag.ObsActive = "ranking";
    ViewBag.Title = T("Rankings de empresas colombianas por ingresos, EBITDA y crecimiento | Bufins Pulso", "Rankings of Colombian companies by revenue, EBITDA and growth | Bufins Pulso");
    ViewBag.MetaDescription = T("Rankings de las principales empresas de Colombia por ingresos, crecimiento, margen EBITDA, utilidad, endeudamiento y salud financiera, por sector, departamento y ciudad.", "Rankings of Colombia's top companies by revenue, growth, EBITDA margin, profit, leverage and financial health, by sector, department and city.");
    ViewBag.Canonical = Request.Url.GetLeftPart(UriPartial.Authority) + "/observatorio/ranking";
}
@section head {
    @Html.Partial("_ObsHead")
}

<section class="obs-hero obs-hero-sm">
    <div class="container">
        <h1 class="obs-title">@T("Rankings de empresas", "Company rankings")</h1>
        <p class="obs-lead">@T("Las empresas líderes de Colombia según sus estados financieros NIIF " + datos.MaxAnio + ", por tema y por lugar.", "Colombia's leading companies from their " + datos.MaxAnio + " IFRS financial statements, by topic and by place.")</p>
    </div>
</section>

@Html.Partial("_ObsNav")

<section class="obs-main">
    <div class="container-xl">
        <h2 class="obs-h3 mb-3">@T("Por tema, en todo el país", "By topic, nationwide")</h2>
        <div class="obs-rank-grid">
            @foreach (var m in ObservatorioService.Rankings)
            {
                var et = T(m.Es, m.En);
                <a class="obs-rank-card" href="/observatorio/ranking/@m.Clave">
                    <strong>@(char.ToUpper(et[0]) + et.Substring(1))</strong>
                    <span>@T("Top 100 nacional", "National top 100")</span>
                </a>
            }
        </div>

        <h2 class="obs-h3 mt-5 mb-3">@T("Por sector económico", "By economic sector")</h2>
        <div class="obs-chips">
            @foreach (var s in hub.Secciones)
            {
                <a href="/observatorio/ranking/ingresos/sector/seccion-@s.Key.ToLowerInvariant()">@cat.Nombre(s.Key)<small>@s.Value.ToString("N0")</small></a>
            }
        </div>

        <h2 class="obs-h3 mt-5 mb-3">@T("Por departamento", "By department")</h2>
        <div class="obs-chips">
            @foreach (var s in hub.Departamentos)
            {
                <a href="/observatorio/ranking/ingresos/departamento/@s.Key">@hub.NombreDepto[s.Key]<small>@s.Value.ToString("N0")</small></a>
            }
        </div>

        <h2 class="obs-h3 mt-5 mb-3">@T("Por ciudad", "By city")</h2>
        <div class="obs-chips">
            @foreach (var s in hub.Ciudades)
            {
                <a href="/observatorio/ranking/ingresos/ciudad/@s.Key">@hub.NombreCiudad[s.Key]<small>@s.Value.ToString("N0")</small></a>
            }
        </div>
    </div>
</section>

@section scripts {
    @Scripts.Render("~/bundles/obs-core")
}
