@using bufinsweb.Helpers
@{
    var T = new Func<string, string, string>(PulsoFormat.T);
    var activo = (string)ViewBag.ObsActive ?? "";
    Func<string, string> cls = k => k == activo ? "active" : "";
}
<span id="obsMeta" data-v="@ViewBag.ObsVer" hidden></span>
<div class="obs-subnav">
    <div class="container-xl obs-subnav-in">
        <nav class="obs-subnav-links" aria-label="Pulso Bufins">
            <a href="/pulso-bufins" class="obs-brand @cls("home")"><i class="fas fa-heart-pulse"></i><span>Pulso Bufins</span></a>
            <i class="obs-subnav-sep" aria-hidden="true"></i>
            <a href="/pulso-bufins/sectores" class="@cls("sectores")"><i class="fas fa-industry"></i><span>@T("Análisis por sector", "Sector analysis")</span></a>
            <a href="/pulso-bufins/ranking" class="@cls("ranking")"><i class="fas fa-trophy"></i><span>@T("Rankings", "Rankings")</span></a>
            <a href="/pulso-bufins/comparar" class="@cls("comparar")"><i class="fas fa-balance-scale"></i><span>@T("Comparar empresas", "Compare companies")</span></a>
            <span class="obs-subnav-tag @cls("empresa")"><i class="fas fa-building"></i><span>@T("Análisis individual", "Company profile")</span></span>
        </nav>
        <div class="obs-subnav-search">
            <div class="obs-input-icon">
                <i class="fas fa-search"></i>
                <input id="obsGlobalSearch" type="search" class="form-control" placeholder="@T("Buscar empresa por nombre o NIT…", "Search company by name or tax ID…")" aria-label="@T("Buscar empresa", "Search company")" />
                <kbd class="obs-kbd" aria-hidden="true" title="@T("Pulsa / para buscar", "Press / to search")">/</kbd>
            </div>
        </div>
        <div class="obs-unit" id="obsUnitBox" data-head="@T("Unidad de las cifras", "Figures unit")" data-sub="@T("Se aplica a todas las cifras en pesos del sitio", "Applies to every peso figure on the site")">
            <button type="button" class="obs-unit-btn" aria-haspopup="listbox" aria-expanded="false" title="@T("Unidad de las cifras en pesos", "Unit for peso figures")" aria-label="@T("Unidad de las cifras", "Figures unit")"><i class="fas fa-coins" aria-hidden="true"></i></button>
            <div class="obs-unit-menu" role="listbox" aria-label="@T("Unidad de las cifras", "Figures unit")" hidden></div>
            <select id="obsUnit" class="form-select form-select-sm" tabindex="-1" aria-hidden="true">
                <option value="auto">@T("Automática", "Automatic")</option>
                <option value="pesos">@T("Pesos", "Pesos")</option>
                <option value="miles">@T("Miles", "Thousands")</option>
                <option value="millones">@T("Millones", "Millions")</option>
                <option value="milmillones">@T("Miles de millones", "Billions")</option>
                <option value="billones">@T("Billones", "Trillions")</option>
            </select>
        </div>
    </div>
</div>
