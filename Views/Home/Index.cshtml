@section scripts {
<script src="~/Assets/js/aos.js"></script>
<script>AOS.init({ duration: 1000, once: true });</script>
<script>
    (function () {
        var modal = document.getElementById('heroCtaModal');
        var choices = document.getElementById('heroCtaChoices');
        var videoWrap = document.getElementById('heroCtaVideoWrap');
        var videoFrame = document.getElementById('heroVideoFrame');
        var showVideoBtn = document.getElementById('heroCtaShowVideo');
        // TODO: reemplazar por la URL embed del video de venta real (YouTube/Vimeo/archivo propio)
        var videoUrl = 'https://www.youtube.com/embed/VIDEO_ID_AQUI?autoplay=1&rel=0';

        showVideoBtn.addEventListener('click', function () {
            choices.classList.add('d-none');
            videoWrap.classList.remove('d-none');
            videoFrame.src = videoUrl;
            modal.classList.add('is-video');
        });

        modal.addEventListener('hidden.bs.modal', function () {
            videoFrame.src = '';
            videoWrap.classList.add('d-none');
            choices.classList.remove('d-none');
            modal.classList.remove('is-video');
        });
    })();
</script>
}
