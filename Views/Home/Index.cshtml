@{
    ViewBag.Title = Resources.Strings.Index_Title;
}

<!-- Hero Section -->
<section class="hero-section" style="background-image: linear-gradient(135deg, rgba(22, 9, 51, 0.85) 0%, rgba(22, 9, 51, 0.78) 50%, rgba(88, 58, 255, 0.6) 100%), url('@Url.Content("~/Assets/images/PortadaDirectivo.jpg")')">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-10 mx-auto text-center" data-aos="fade-up" data-aos-duration="1200">
                <div class="hero-category mb-4">
                    <span class="hero-platform-tag">@Resources.Strings.Index_HeroBadge</span>
                </div>
                <h1 class="hero-title mb-4">
                    @Resources.Strings.Index_HeroPart1 <span class="text-italic">@Resources.Strings.Index_HeroEmphasis</span><br />
                    @Resources.Strings.Index_HeroPart2
                </h1>
                <p class="hero-subtitle mb-5">
                    <strong class="hero-brand">Bufins</strong> @Resources.Strings.Index_HeroSubtitle
                </p>
                <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#heroCtaModal">@Resources.Strings.Index_HeroCTA</button>
            </div>
        </div>
    </div>
</section>

<!-- Hero CTA Modal -->
<div class="modal fade hero-cta-modal" id="heroCtaModal" tabindex="-1" aria-labelledby="heroCtaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="mhead">
                <div class="titles">
                    <span class="kicker">Bufins</span>
                    <h2 class="modal-title" id="heroCtaModalLabel">@Resources.Strings.Index_HeroModalTitle</h2>
                </div>
                <button type="button" class="mclose" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="mbody">
                <div id="heroCtaChoices" class="d-flex flex-column gap-2">
                    <button type="button" id="heroCtaShowVideo" class="opt primary">
                        <div class="ic"><i class="fa-solid fa-play"></i></div>
                        <div class="txt">
                            <span class="t">@Resources.Strings.Index_HeroModalVideoCTA</span>
                            <span class="s">@Resources.Strings.Index_HeroModalVideoSubCTA</span>
                        </div>
                        <i class="fa-solid fa-arrow-right go"></i>
                    </button>
                    <a href="@Url.Action("Contact", "Home")" class="opt secondary">
                        <div class="ic"><i class="fa-solid fa-headset"></i></div>
                        <div class="txt">
                            <span class="t">@Resources.Strings.Index_HeroModalSalesCTA</span>
                            <span class="s">@Resources.Strings.Index_HeroModalSalesSubCTA</span>
                        </div>
                        <i class="fa-solid fa-arrow-right go"></i>
                    </a>
                </div>
                <div id="heroCtaVideoWrap" class="ratio ratio-16x9 d-none mt-3">
                    <iframe id="heroVideoFrame" src="" title="@Resources.Strings.Index_HeroModalVideoCTA" allow="autoplay; fullscreen" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

