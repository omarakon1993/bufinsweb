                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob4</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob5</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob6</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob7</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob8</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob9</div></div>
                    <div class="col-md-6"><div class="problem-item">@Resources.Strings.Index_Prob10</div></div>
