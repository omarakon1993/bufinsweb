@{
    ViewBag.Title = Resources.Strings.About_Title;
}

<!-- Services Hero -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-12 text-center" data-aos="fade-up">
                <h1 class="hero-title mb-5">
                    @Resources.Strings.About_HeroWord1<br />
                    @Resources.Strings.About_HeroWord2<br />
                    @Resources.Strings.About_HeroWord3<br />
                    <span class="brand-text">Bufins</span>
                </h1>
                <p class="lead">@Resources.Strings.About_HeroDescPart1<br /><strong>@Resources.Strings.About_HeroDescEmphasis</strong> @Resources.Strings.About_HeroDescPart2</p>
            </div>
        </div>
    </div>
</section>

<!-- Objectives Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h4>@Resources.Strings.About_Obj1</h4>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-calculator"></i>
                    </div>
                    <h4>@Resources.Strings.About_Obj2</h4>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <h4>@Resources.Strings.About_Obj3</h4>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h4>@Resources.Strings.About_Obj4</h4>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Generalidades Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="text-purple">@Resources.Strings.About_GenTitle</h2>
        </div>
        <div class="row">
            <div class="col-lg-10 mx-auto" data-aos="fade-up">
                <ul class="modules-list">
                    <li>@Resources.Strings.About_Gen1</li>
                    <li>@Resources.Strings.About_Gen2</li>
                    <li>@Resources.Strings.About_Gen3</li>
                    <li>@Resources.Strings.About_Gen4</li>
                    <li>@Resources.Strings.About_Gen5</li>
                    <li>@Resources.Strings.About_Gen6</li>
                    <li>@Resources.Strings.About_Gen7</li>
                    <li>@Resources.Strings.About_Gen8</li>
                    <li>@Resources.Strings.About_Gen9</li>
                    <li>@Resources.Strings.About_Gen10</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Consultant Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="text-purple">@Resources.Strings.About_ConsultantTitle</h2>
            <h3 class="mt-3">Marta Elena Hoyos</h3>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature-card">
                    <h5 class="text-purple mb-3">@Resources.Strings.About_BackgroundTitle</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>@Resources.Strings.About_Edu1Degree</strong><br />Universidad de Medellín</li>
                        <li class="mb-2"><strong>@Resources.Strings.About_Edu2Degree</strong><br />Universidad EAFIT</li>
                        <li class="mb-2"><strong>@Resources.Strings.About_Edu3Degree</strong><br />@Resources.Strings.About_Edu3School</li>
                        <li class="mb-2"><strong>@Resources.Strings.About_Edu4Degree</strong><br />Universidad de Asturias</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature-card">
                    <h5 class="text-purple mb-3">@Resources.Strings.About_ExpertiseTitle</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">@Resources.Strings.About_Exp1</li>
                        <li class="mb-2">@Resources.Strings.About_Exp2</li>
                        <li class="mb-2">@Resources.Strings.About_Exp3</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="feature-card">
                    <h5 class="text-purple mb-3">@Resources.Strings.About_SectorsTitle</h5>
                    <p class="small">@Resources.Strings.About_SectorsText</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="final-cta-section py-5">
    <div class="container text-center" data-aos="fade-up">
        <h2 class="text-white display-4 mb-4">@Resources.Strings.About_CtaTitle</h2>
        <p class="lead text-cyan mb-4">@Resources.Strings.About_CtaSubtitle</p>
        <a href="@Url.Action("Contact", "Home")" class="btn btn-cyan btn-lg mt-4">@Resources.Strings.About_CtaBtn</a>
    </div>
</section>

@section scripts {
<script src="~/Assets/js/aos.js"></script>
<script>
    AOS.init({
        duration: 1000,
        once: true
    });
</script>
}
