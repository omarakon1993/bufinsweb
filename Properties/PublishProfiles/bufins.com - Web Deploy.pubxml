<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicacion de bufins.com (Visual Studio: clic derecho en el proyecto > Publicar > "bufins.com - Web Deploy").
  La contrasena de Web Deploy NO esta en este archivo: Visual Studio la guarda cifrada en el .pubxml.user (ignorado por git).

  Por que estas opciones (el hosting de Conexcol no tiene el runtime de .NET 10):
    - SelfContained + win-x64: el paquete lleva su propio runtime de .NET (unos 205 MB).
    - EnableMSDeployAppOffline: pone app_offline.htm mientras se copian los archivos; sin esto, los .dll en uso fallan al reemplazarse.
    - SkipExtraFilesOnServer: NO borra lo que solo existe en el servidor (secretsSettings.json, App_Data\pulso\uso, logs, .user.ini de Plesk).
    - EnableMSDeployBackup apagado: cada copia de respaldo en el servidor pesaria ~200 MB y llenaria el espacio del plan.
      El respaldo se hace antes con Tools\Despliegue\Desplegar-Bufins.ps1 -Accion Respaldar.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://bufins.com</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <MSDeployServiceURL>https://bufins.com:8172/msdeploy.axd?site=bufins.com</MSDeployServiceURL>
    <DeployIisAppPath>bufins.com</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <UserName>oglearni</UserName>
    <_SavePWD>true</_SavePWD>

    <!-- .NET 10 en el hosting compartido: runtime incluido en el paquete -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- seguridad de los archivos del servidor -->
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
